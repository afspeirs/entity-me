{
  "name": "entity-me",
  "version": "1.14.0-develop.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "pwa": "npm run build && npm run preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "type": "npm run check",
    "lint": "eslint .",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:open": "playwright test --ui",
    "test:install": "playwright install chromium firefox webkit",
    "semantic-release:dry": "semantic-release --dry-run --no-ci",
    "outdated": "npx npm-check-updates",
    "outdated:minor": "npx npm-check-updates -t minor",
    "update": "npm run outdated -- -u",
    "update:minor": "npm run outdated:minor -- -u"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@lucide/svelte": "^1.55.0",
    "@playwright/test": "^1.64.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/svelte-virtual-list": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.19.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "melt": "^0.44.0",
    "semantic-release": "^25.0.9",
    "start-server-and-test": "^2.1.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0",
    "tippy.js": "^6.3.7",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@vite-pwa/sveltekit": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
